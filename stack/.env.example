# Copy to stack/.env (git-ignored) or `set -a; . stack/.env.example; set +a`.
# Only local development values belong here — never a real credential.

# Checkout locations (no host-specific paths are baked into compose files)
SUPERSET_DIR=/home/ubuntu/repos/superset
AUTOMATION_DIR=/home/ubuntu/repos/devin-automation

# Superset light stack
SUPERSET_PORT_BIND=127.0.0.1
SUPERSET_PORT_HOST=8088
SUPERSET_MCP_PORT_HOST=5008
SUPERSET_NETWORK=superset_default

# Portal (bind to loopback; the admin MCP endpoint is never published)
PORTAL_PORT_BIND=127.0.0.1
PORTAL_PORT_HOST=8090
PORTAL_ENVIRONMENT_KIND=baseline-light
PORTAL_RUN_ID=local
PORTAL_OPS_USERNAME=operator
PORTAL_OPS_PASSWORD=operator-local

# Upstream identities are server-side only; the browser never supplies them.
#
# Two different vantage points, so sourcing this file is safe for both:
#   SUPERSET_BASE_URL / SUPERSET_MCP_URL  -- from the HOST (seed, provenance,
#     scenario scripts) and therefore loopback, matching the bound ports above.
#   *_CONTAINER_*                          -- from inside the portal container,
#     which reaches the stack by service name on the shared network.
SUPERSET_BASE_URL=http://127.0.0.1:8088
SUPERSET_MCP_URL=http://127.0.0.1:5008/mcp
SUPERSET_CONTAINER_BASE_URL=http://superset-light:8088
SUPERSET_CONTAINER_MCP_URL=http://superset-mcp-light:5008/mcp
SUPERSET_USERNAME=admin
SUPERSET_PASSWORD=admin
SUPERSET_RESTRICTED_USERNAME=restricted_analyst
SUPERSET_RESTRICTED_PASSWORD=restricted-analyst-local

AUTO_REPAIR_ENABLED=false
